    <!-- Tasks -->
    <string name="tasks_title">Tarefas</string>
    <string name="tasks_subtitle">Tarefas agendadas do assistente que rodam pelo Teale na rede. Confiável hoje significa jobs do WorkManager, requisitos de capacidade explícitos e limites honestos do Android.</string>
